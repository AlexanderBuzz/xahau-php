{
  "name": "hardcastle/xahau-php",
  "description": "PHP SDK / Client for the Xahau Network, built on hardcastle/xrpl_php",
  "type": "library",
  "keywords": [
    "xahau",
    "hooks",
    "xrpl",
    "blockchain",
    "client",
    "sdk"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Alexander Busse",
      "email": "alexander.busse@posteo.net"
    }
  ],
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Hardcastle\\Xahau_PHP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hardcastle\\Xahau_PHP\\Test\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.27"
    }
  },
  "require": {
    "php": "^8.2",
    "brick/math": ">=0.14.2 <0.15",
    "hardcastle/xrpl_php": "^3.2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "vimeo/psalm": "^6.8 || ^7.0",
    "donatj/mock-webserver": "^2.10"
  },
  "scripts": {
    "psalm": "vendor/bin/psalm --config=psalm.xml",
    "test": "vendor/bin/phpunit --exclude-group integration"
  }
}
